{
  "name": "material-fox-updated",
  "description": "Firefox user CSS theme, inspired by material design",
  "version": "2.0.7",
  "private": true,
  "type": "module",
  "author": "https://github.com/edelvarden",
  "license": "MIT",
  "scripts": {
    "dev": "sass --quiet --watch --no-source-map --style compressed src/user-chrome.scss:chrome/user-chrome.css src/user-content.scss:chrome/user-content.css",
    "build": "sass --quiet --no-source-map --style compressed src/user-chrome.scss:chrome/user-chrome.css src/user-content.scss:chrome/user-content.css",
    "format": "prettier --write src/ scripts/",
    "lint": "prettier --check src/ scripts/",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.3",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "selenium-webdriver": "^4.50.0"
  }
}
